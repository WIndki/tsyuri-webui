{
    "name": "tsyuri-webui",
    "version": "0.2.0",
    "private": true,
    "engines": {
        "node": ">=20.9.0"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "verify": "npm run typecheck && npm run lint && npm run build",
        "e2e": "node scripts/e2e-check.mjs",
        "e2e:browser": "node scripts/e2e-browser.mjs",
        "check:deprecations": "node scripts/check-deprecations.mjs",
        "screenshots": "node scripts/screenshots-detail.mjs"
    },
    "dependencies": {
        "@ant-design/icons": "^6.3.4",
        "@ant-design/nextjs-registry": "^1.3.0",
        "antd": "^6.6.4",
