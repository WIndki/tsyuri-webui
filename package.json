        "react-dom": "^19.3.0",
        "undici": "^8.10.2"
    },
    "devDependencies": {
        "@types/node": "^22.18.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.0",
        "eslint-config-next": "^16.3.5",
        "playwright": "^1.63.0",
        "typescript": "^5.9.3"
    }
}
